# macOS
.DS_Store

# Personal scratch workspaces (_scratch/): only the folder and its README exist in git.
# Each person works in _scratch/<handle>/ ; nothing in it is shared or reviewed.
_scratch/*
!_scratch/.gitkeep
!_scratch/README.md

# Per-machine agent and OpenKnowledge state
.ok/local
.claude/settings.local.json

# Pinned gitleaks downloaded by .githooks/pre-commit
.bin/

# Never commit credentials
.env
.env.*

# Generated per-machine agent projections; restored by `ok init`
.claude/
.codex/
.opencode/
.cursor/
.pi/
.github/skills/
opencode.json
.mcp.json

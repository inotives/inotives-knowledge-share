#!/bin/sh
# Local stand-in for CI. Enable once per clone:  git config core.hooksPath .githooks
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "pre-commit: checking frontmatter, links and skills"
python3 -I .github/scripts/check_docs.py

echo "pre-commit: scanning staged changes for secrets"
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  docker run --rm -v "$ROOT:/repo" zricethezav/gitleaks:latest \
    protect --source /repo --staged --no-banner --redact
else
  if [ "${SKIP_SECRET_SCAN:-}" = "1" ]; then
    echo "pre-commit: WARNING secret scan skipped because SKIP_SECRET_SCAN=1; CI still scans" >&2
  else
    echo "pre-commit: ERROR neither gitleaks nor a running docker was found, so staged changes cannot be scanned." >&2
    echo "pre-commit: install gitleaks (brew install gitleaks) or start docker. To skip once, run: SKIP_SECRET_SCAN=1 git commit" >&2
    exit 1
  fi
fi

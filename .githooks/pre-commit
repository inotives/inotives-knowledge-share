#!/bin/sh
# Local stand-in for CI. Enable once per clone:  git config core.hooksPath .githooks
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "pre-commit: checking frontmatter, links and skills"
python3 -I .github/scripts/check_docs.py

# --- secret scan -------------------------------------------------------------
# Uses `gitleaks` from PATH if present. Otherwise downloads the pinned release
# below into .bin/ (gitignored), verifies its SHA-256, and uses that copy.
# If no scanner can be had (offline, unsupported platform, failed download) or
# the checksum does not match, the commit is refused. To skip the scan once, run
# `SKIP_SECRET_SCAN=1 git commit`; CI still scans every pull request.
#
# To upgrade: change GITLEAKS_VERSION and all four checksums together, copying
# the checksums from gitleaks_<version>_checksums.txt on the official release
# page: https://github.com/gitleaks/gitleaks/releases
GITLEAKS_VERSION="8.30.1"
GITLEAKS_SHA256_darwin_arm64="b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5"
GITLEAKS_SHA256_darwin_x64="dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709"
GITLEAKS_SHA256_linux_arm64="e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080"
GITLEAKS_SHA256_linux_x64="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"

sha256_of() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
  else sha256sum "$1" | cut -d' ' -f1; fi
}

# Prints the path of a usable gitleaks on stdout. Return codes:
#   0 found   1 not available (warning on stderr)   2 checksum mismatch
# It runs in a subshell, so the caller decides what each code means.
find_gitleaks() {
  if command -v gitleaks >/dev/null 2>&1; then command -v gitleaks; return 0; fi

  case "$(uname -s)" in Darwin) os=darwin ;; Linux) os=linux ;; *) os="" ;; esac
  case "$(uname -m)" in arm64|aarch64) arch=arm64 ;; x86_64|amd64) arch=x64 ;; *) arch="" ;; esac
  if [ -z "$os" ] || [ -z "$arch" ]; then
    echo "pre-commit: no pinned gitleaks for this platform ($(uname -s) $(uname -m)); install gitleaks to scan locally" >&2
    return 1
  fi

  dir=".bin/gitleaks-$GITLEAKS_VERSION"
  if [ -x "$dir/gitleaks" ]; then echo "$ROOT/$dir/gitleaks"; return 0; fi

  want="$(eval echo "\$GITLEAKS_SHA256_${os}_${arch}")"
  archive="gitleaks_${GITLEAKS_VERSION}_${os}_${arch}.tar.gz"
  url="https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/${archive}"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT

  echo "pre-commit: downloading gitleaks $GITLEAKS_VERSION ($os $arch) once into .bin/" >&2
  if ! curl -fsSL --max-time 120 -o "$tmp/$archive" "$url"; then
    echo "pre-commit: WARNING gitleaks download failed; secret scan skipped (CI still scans)" >&2
    return 1
  fi
  got="$(sha256_of "$tmp/$archive")"
  if [ "$got" != "$want" ]; then
    echo "pre-commit: ERROR gitleaks checksum mismatch, commit refused" >&2
    echo "  expected $want" >&2
    echo "  got      $got" >&2
    return 2
  fi
  mkdir -p "$dir"
  tar -xzf "$tmp/$archive" -C "$dir" gitleaks
  chmod +x "$dir/gitleaks"
  echo "$ROOT/$dir/gitleaks"
}

echo "pre-commit: scanning staged changes for secrets"
GITLEAKS="$(find_gitleaks)" && rc=0 || rc=$?
case "$rc" in
  0) "$GITLEAKS" protect --staged --no-banner --redact ;;
  1)
    if [ "${SKIP_SECRET_SCAN:-}" = "1" ]; then
      echo "pre-commit: WARNING secret scan skipped because SKIP_SECRET_SCAN=1; CI still scans" >&2
    else
      echo "pre-commit: ERROR no gitleaks could be found or downloaded, so staged changes cannot be scanned." >&2
      echo "pre-commit: install gitleaks (see INSTRUCTIONS.md) or fix the network. To skip once, run: SKIP_SECRET_SCAN=1 git commit" >&2
      exit 1
    fi
    ;;
  *) exit 1 ;;
esac
